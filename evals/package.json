{
  "name": "oblique-skills-evals",
  "version": "1.0.0",
  "private": true,
  "description": "promptfoo evals for the Oblique skills, run on the BIT AI model gateway",
  "license": "Proprietary",
  "type": "commonjs",
  "scripts": {
    "eval": "promptfoo eval -c promptfooconfig.yaml --no-cache --env-file ~/.agent-credentials/env",
    "eval:toolchain": "promptfoo eval -c promptfooconfig.yaml --no-cache --env-file ~/.agent-credentials/env --filter-pattern \"ob-toolchain #\"",
    "eval:oblique": "promptfoo eval -c promptfooconfig.yaml --no-cache --env-file ~/.agent-credentials/env --filter-pattern \"oblique #\"",
    "results": "node aggregate-results.js",
    "view": "promptfoo view"
  },
  "dependencies": {
    "promptfoo": "^0.124.0"
  }
}
